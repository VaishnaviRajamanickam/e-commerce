
body {
    margin: 0;
    font-family: Arial;
    background: #f4f4f4;
}

header {
    background: #202c45;
    color: white;
    text-align: center;
    padding: 20px;
}

.container {
    padding: 30px;
}

.products {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.product {
    background: white;
    padding: 20px;
    width: 180px;
    border-radius: 10px;
    text-align: center;
}

button {
    background: #2878d0;
    color: white;
    border: none;
    padding: 10px 15px;
    cursor: pointer;
    border-radius: 5px;
}

button:hover {
    background: #14549b;
}

